#cloud-config
autoinstall:
  # version is an Autoinstall required field.
  version: 1

  apt:
    fallback: offline-install

  locale: en_US
  keyboard:
    layout: us

  shutdown: reboot

  storage:
    layout:
      name: direct
    swap:
      size: 0





  # Custom Commands.
  late-commands:
    - cp /cdrom/vboxpostinstall.sh /target/root/vboxpostinstall.sh
    - chmod +x /target/root/vboxpostinstall.sh
    - curtin in-target --target=/target -- /bin/bash /root/vboxpostinstall.sh --direct

  # Additional cloud-init configuration affecting the target system can be supplied
  # underneath a user-data section inside of autoinstall.
  user-data:
    hostname: 'sih-server'
    users:
      - name: root
        primary_group: root
        groups: sudo
        lock-passwd: false
        passwd: '$6$t5SDJ3xuezih9VNx$/dg3fvz1d22DDtvMF04BiWdI9WMSsvoJfJP9kHpJAWxaBBZFNKG7sH1cafBBQQ7DbTZW6Ty7l/dWL3ezNyehx/'
        uid: 0

      - name: 'tanishaq'
        gecos: 'tanishaq'
        primary_group: 'tanishaq'


        groups: sudo

        lock-passwd: false
        shell: /bin/bash
        passwd: '$6$VfW6zD6m.Knv1vxc$1jxfyLgXoxJlvOgqp7I7Uqmb99zutHp3/Z7LWTQebEzTlO95QpcLKdBlSd1RgIRNvXT/utOzCrSi9cYJ/YpB0/'


